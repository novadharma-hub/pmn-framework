-/* ===================================================================
-   RONDE 8 — sapuan: AI Terminal & halaman panduan (2026-09-04)
-   =================================================================== */
-
-/* "PMN will prepare a grounded prompt..." terhimpit ke dropdown mode dan
-   baris input di bawahnya. Sebabnya `space-y-5` di panel: utility itu
-   bekerja lewat margin pada anak, sementara style.css:401 memuat reset
-   universal `*{margin:0;padding:0}` yang TIDAK berlapis - dan urutan lapis
-   mengalahkan spesifisitas. Jadi seluruh utility jarak Tailwind inert di
-   proyek ini. Ditulis sebagai CSS sungguhan. */
-.hai-panel > * + * { margin-top: 20px; }
-.hai-redirect-desc { line-height: 1.7; }
-.hai-panel .home-ai-actions { padding-top: 20px; }
-#home-chat-log .hcl-placeholder { line-height: 1.75; opacity: .75; }
-#home-chat-log .hcl-placeholder br { display: block; content: ""; margin-top: 10px; }
-
-/* Tab "Inline chat - planned" adalah keterangan status, bukan tujuan
-   setara. Dibedakan supaya tidak terbaca sebagai fitur rusak. */
-.hai-tab:last-child {
-  opacity: .7;
-  border-style: dashed;
-}
-.hai-tab:last-child.active { opacity: 1; }
-
-/* HALAMAN PANDUAN
-   Lebar baris 850px pada teks 16px = 85 karakter, jauh di atas rentang
-   nyaman baca 45-75. Dan jarak antar-alinea 1rem (16px) lebih RAPAT
-   daripada jarak antar-baris 29.12px - cacat terbalik yang sama dengan
-   reader sebelum Ronde 2. */
-#guide-view .intro p,
-#guide-view .step p,
-#guide-view .page-body {
-  max-width: 68ch;
-}
-#guide-view .intro p + p,
-#guide-view .step p + p {
-  margin-top: 34px;
-}
-
-/* "Return Home" terpecah jadi dua baris di header panduan. */
-#guide-view .sv-hdr-wrap button { white-space: nowrap; }
-
-/* Jarak strip tab ke panel di bawahnya: `mb-6` pada .hai-tabs juga inert
-   karena reset universal yang sama. */
-.hai-tabs { margin-bottom: 24px; }
