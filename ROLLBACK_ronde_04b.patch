diff --git b/style.css a/style.css
index 0a091f9..678243d 100644
--- b/style.css
+++ a/style.css
@@ -2781,11 +2781,7 @@ body, #hdr, #mob-nav, .view, .path-card, .thesis-item, .thesis-toggle, .anatomy-
   z-index: 2;
   appearance: none;
   cursor: pointer;
-  /* JANGAN pakai `font: inherit` di sini. Shorthand itu menghapus
-     deklarasi font .sb-plbl (Source Code Pro 11.5px) dan menggantinya
-     dengan warisan body (Lora 16px), sehingga header part melompat jauh
-     dari item seksi di bawahnya. Jangan pula pakai 
-     dengan alasan yang sama. Reset tombol hanya yang perlu saja. */
+  font: inherit;
   border-top: none;
   border-right: none;
   backdrop-filter: blur(6px);
@@ -2903,22 +2899,3 @@ body, #hdr, #mob-nav, .view, .path-card, .thesis-item, .thesis-toggle, .anatomy-
    setinggi isinya masing-masing. */
 #glossary-panel .grid { align-items: start; }
 .gl-card { min-height: 0; }
-
-/* Jarak ukuran header-part vs item-seksi dulu 16px KAPITAL vs 12px biasa.
-   Huruf kapital mengisi seluruh tinggi em, jadi selisihnya terbaca jauh
-   lebih besar dari angkanya, dan judul panjang terdorong jadi 3 baris.
-   Sekarang keduanya nyaris seukuran; pembedanya GAYA (mono berspasi vs
-   serif), bukan ukuran. */
-.sb-plbl {
-  font-size: calc(.78rem * var(--sidebar-scale));
-  letter-spacing: .1em;
-  font-weight: 700;
-}
-/* Judul seksi tak lagi miring - masalah yang sama dengan definisi
-   glosarium: satu daftar penuh italic melelahkan dan menghapus fungsi
-   italic sebagai penekanan. Item aktif dibedakan bobot dan warna. */
-.sb-ilbl {
-  font-style: normal;
-  font-size: calc(.84rem * var(--sidebar-scale));
-}
-.sb-ilbl.on { font-weight: 600; }
