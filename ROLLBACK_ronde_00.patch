-
-/* --acc (#c0271a gelap) hanya 3.28 kontras di atas --bg: gagal WCAG AA
-   untuk teks. Peran teks dipindah ke --acc-text; peran isian (latar,
-   garis, penanda) tetap memakai --acc. Deklarasi color: di style.css dan
-   inline style TSX sudah diganti langsung; empat varian utility Tailwind
-   di bawah ini menutup 52 pemakaian di komponen tanpa menyunting TSX.
-   Selektor atribut dipakai agar tidak bergantung pada bentuk selektor
-   ter-escape yang dihasilkan Tailwind. style.css diimpor setelah
-   index.css di main.tsx, jadi urutan cascade memenangkan aturan ini. */
-[class~="text-pmn-acc"] { color: var(--acc-text); }
-[class~="hover:text-pmn-acc"]:hover { color: var(--acc-text); }
-[class~="group-hover:text-pmn-acc"]:is(:where(.group):hover *) { color: var(--acc-text); }
-[class~="text-pmn-acc/80"] { color: color-mix(in oklab, var(--acc-text) 80%, transparent); }
