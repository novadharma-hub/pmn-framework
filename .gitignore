# PMN Framework - .gitignore

# Microsoft Word temporary lock files
~$*.docx
~$*.doc
~$*.xlsx
~$*.pptx

# OS temporary files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & secrets
.env
.env.local
.env.*.local

# IDE / Editor
.vscode/
.idea/
*.suo
*.user
.history/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Local build artifacts, backups, logs
*.bak
*.patch
*.log
backup/
legacy/

# Local-only working files: never published
private/
*.enc
*.docx
*.doc
supabase/
PRD.md

# Ignore versioned release assets to prevent Git history bloat
dist/PMN_Framework_v*.pdf
dist/PMN_Framework_v*.md
public_static/PMN_Framework_v*.pdf
public_static/PMN_Framework_v*.md

# Stale snapshots
src/txt/
index.ui.2.html

# Local tool state (editors, agents, hooks)
.claude/
.mimosa/

# Build outputs of scripts/build_ai_surfaces.py (static edition, plain-text
# sections, sitemap). Regenerated from parts.json on every `npm run build`.
dist/txt/
dist/read/
dist/sitemap.xml

# Build output of scripts/build_skill.py (the Agent Skill download).
dist/pmn-skill.zip
